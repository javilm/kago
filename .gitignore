.DS_Store

# Products, not sources. Both tools truncate their output, so nothing
# here needs cleaning up - it just must not be committed.
*.tro
*.com
*.bin
*.rom
*.prn
*.lst
*.sym
*.map
results.txt
results.old
dates.txt
speed.txt
memory.txt
dist/

# What the extraction tests leave behind, but for _keep.txt, which
# keeps the directory
tests/out/*
!tests/out/_keep.txt

# ...except the pair we ship built
!build/kago.com
!build/unkago.com

# ...and test inputs, which may have any extension: a test that
# compresses a ROM image must not lose its input to the rule above
!tests/**/*.bin
!tests/**/*.rom
!tests/**/*.com

# Files that may have been brought over by mistake when
# cloning the emulator's filesystem to the repo
git/
_to_dele/
gitattri
gitignor
ds_store
changelo.md
