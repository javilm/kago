; kago.lnk - the modules of KAGO, in link order
kago.tro			; the entry point comes first
lzhw.tro			; writing LZH headers
zipw.tro			; writing ZIP headers
lh5w.tro			; packing, -lh5-
seglist.tro			; lists in the mapper
lzh.tro				; reading LZH archives, for /A
zip.tro				; reading ZIP archives, for /A
crc.tro				; the CRC-16, shared with UNKAGO
progress.tro			; the progress line, shared with UNKAGO
common.tro			; shared with UNKAGO and MAPTEST
alloc.tro			; MapperHeap
